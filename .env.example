# Settings of kindergarten-email-checker. Copy this file to .env and edit the copy.

# =====================================================================================
# Required settings. Replace each example value.
# =====================================================================================

# Address of the dedicated mailbox. The app reads only this account.
IMAP_USER=your.dedicated.address@gmail.com
# App password of the dedicated mailbox. The app removes the spaces.
IMAP_PASSWORD=xxxx xxxx xxxx xxxx

# The allowlist. Full email addresses, comma-separated. Case-insensitive.
# The app moves email from all other senders to the Ignored label without a post.
# The app starts without this setting, but then it moves every email to the Ignored label.
ALLOWED_SENDERS=direccion@kinder.example,secretaria@kinder.example

# DeepSeek API key.
LLM_API_KEY=sk-...

# Telegram bot token, and the id of the group that the bot posts to. Group ids are negative.
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=-1001234567890

# =====================================================================================
# Optional settings. Each value is the default.
# =====================================================================================

# IMAP server of the dedicated mailbox.
IMAP_HOST=imap.gmail.com
# Timeout of one IMAP command.
IMAP_TIMEOUT_SECONDS=60

# Gmail labels that hold the state. The app creates a missing label at each poll.
IMAP_FOLDER_INBOX=INBOX
IMAP_FOLDER_PROCESSED=Processed
IMAP_FOLDER_IGNORED=Ignored
IMAP_FOLDER_FAILED=Failed

# Model: DeepSeek through its Anthropic-compatible endpoint. Thinking stays enabled.
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-flash
# Thinking effort: low, high or max.
LLM_EFFORT=high
# Timeout of one model request.
LLM_TIMEOUT_SECONDS=120
# The name of the tool that returns the summary. prompt.md gets the same name.
LLM_TOOL_NAME=report_summary
# Output limit of one model call, for thinking and the tool call together.
LLM_MAX_TOKENS=16000
# Model calls for one email. The app calls the model again only when the answer is unusable.
# After the last unusable answer, the post holds the original text without a summary.
# The value must be more than 0. With 0, the app never calls the model.
LLM_MODEL_TRIES=2
# Timeout of the balance check at start.
LLM_BALANCE_TIMEOUT_SECONDS=30

# Telegram Bot API server.
TELEGRAM_BASE_URL=https://api.telegram.org
# Telegram's limit for one message. Longer posts are trimmed.
TELEGRAM_MAX_MESSAGE_CHARS=4096
# Length of the error text in an error post. Longer error texts are trimmed.
# The log holds the full error.
TELEGRAM_MAX_ERROR_CHARS=500
# Timeout of one Telegram request.
TELEGRAM_TIMEOUT_SECONDS=30

# Content extraction. Smaller images are logos and signature graphics, and are skipped.
# A PDF with fewer characters per page than PDF_TEXT_MIN_CHARS_PER_PAGE is sent as page images.
MIN_IMAGE_BYTES=20480
MAX_PDF_PAGES_RENDERED=10
PDF_TEXT_MIN_CHARS_PER_PAGE=200
PDF_RENDER_DPI=110
MAX_BODY_CHARS=40000
MAX_PDF_TEXT_CHARS=20000

# Loop behaviour. The app polls the mailbox every POLL_MINUTES.
# Attachments larger than MAX_ATTACHMENT_MB are not sent to the model.
POLL_MINUTES=10
MAX_ATTACHMENT_MB=10
MAX_RETRIES_PER_MESSAGE=3
# One log level for the app and all libraries.
# At INFO and DEBUG, the log shows the URL of each Telegram request, with the bot token masked.
LOG_LEVEL=INFO

# Timezone of the dates in the prompt and in the posts.
TZ=America/Argentina/Buenos_Aires

# Port of the health checks /readyz and /livez. On Kubernetes, set healthPort in the chart values.
HEALTH_PORT=8080

# Image tag on ghcr.io to run. Only Docker Compose reads it. 
IMAGE_TAG=latest
